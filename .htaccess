# =====================================================================
#  MME Private Limited — Apache config (shared hosting / cPanel ready)
# =====================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php
RewriteEngine On

# Force HTTPS (comment out if SSL not yet installed)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Clean-URL routing (preserves original React routes) ----
# Never rewrite real files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# We Are
RewriteRule ^we-are/?$ we-are/about-company.php [L]
RewriteRule ^we-are/about-company/?$ we-are/about-company.php [L]
RewriteRule ^we-are/board-of-directors/?$ we-are/board-of-directors.php [L]
RewriteRule ^we-are/our-team/?$ we-are/our-team.php [L]
RewriteRule ^we-are/our-clients/?$ we-are/our-clients.php [L]
RewriteRule ^we-are/annual-report/?$ we-are/annual-report.php [L]

# We Serve
RewriteRule ^we-serve/?$ we-serve/index.php [L]
RewriteRule ^we-serve/([A-Za-z0-9-]+)/?$ we-serve/category.php?category=$1 [L,QSA]
RewriteRule ^we-serve/([A-Za-z0-9-]+)/([A-Za-z0-9-]+)/?$ we-serve/detail.php?category=$1&sub=$2 [L,QSA]

# Services
RewriteRule ^services/?$ services.php [L]
RewriteRule ^services/([A-Za-z0-9-]+)/?$ service-detail.php?id=$1 [L,QSA]

# Flat pages
RewriteRule ^about/?$ about.php [L]
RewriteRule ^projects/?$ projects.php [L]
RewriteRule ^industries/?$ industries.php [L]
RewriteRule ^clients/?$ clients.php [L]
RewriteRule ^gallery/?$ gallery.php [L]
RewriteRule ^careers/?$ careers.php [L]
RewriteRule ^contact/?$ contact.php [L]

# ---- Custom error pages ----
ErrorDocument 404 /404.php

# ---- Security headers (safe on shared hosting) ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# ---- Protect sensitive files ----
<FilesMatch "\.(env|log|md|map)$">
  Require all denied
</FilesMatch>
<Files "form-config.js">
  Require all denied
</Files>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
